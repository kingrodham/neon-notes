# Create a dedicated PostgreSQL database first. Never commit real credentials.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5433/neon_notes
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3000
NODE_ENV=development
# Tests require a separate disposable database whose name ends in _test.
# TEST_DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5433/neon_notes_test
