<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= mode === 'register' ? 'Create account' : 'Sign in' %> — Neon Notes</title><link rel="stylesheet" href="/styles.css"></head>
<body><a class="skip-link" href="#auth-title">Skip to content</a><main>
<%- include('partials/nav') %>
<section class="auth-layout">
  <div class="auth-intro"><p class="eyebrow">YOUR IDEAS. YOUR SPACE.</p><h1>A home for<br><span>your next thought.</span></h1><p class="intro">Keep your notes in one place, with a personal account and posts that stay saved.</p><ul class="auth-benefits"><li>A private collection, just for you</li><li>Pick up where you left off</li><li>Edit your ideas as they evolve</li></ul></div>
  <section class="panel auth-panel" aria-labelledby="auth-title">
    <h2 id="auth-title"><%= mode === 'register' ? 'Create your account' : 'Welcome back' %></h2>
    <p class="muted"><%= mode === 'register' ? 'Make a little space for your ideas.' : 'Sign in to return to your notes.' %></p>
    <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
    <form class="editor-form" action="/<%= mode %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (mode === 'register') { %><label for="displayName">YOUR NAME</label><input id="displayName" name="displayName" autocomplete="name" maxlength="60" value="<%= values.displayName || '' %>" required><% } %>
      <label for="email">EMAIL ADDRESS</label><input id="email" type="email" name="email" autocomplete="email" maxlength="254" value="<%= values.email || '' %>" required>
      <label for="password">PASSWORD</label><input id="password" type="password" name="password" autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>" <%= mode === 'register' ? 'minlength=12' : '' %> maxlength="128" aria-describedby="password-help" required>
      <p id="password-help" class="field-help"><%= mode === 'register' ? 'Use 12–128 characters. A unique passphrase works well.' : 'Use the password you chose when creating your account.' %></p>
      <button class="primary" type="submit"><%= mode === 'register' ? 'Create account' : 'Sign in' %><span aria-hidden="true">↗</span></button>
    </form>
    <p class="auth-switch"><%= mode === 'register' ? 'Already have an account?' : 'New here?' %> <a class="text-link" href="/<%= mode === 'register' ? 'login' : 'register' %>"><%= mode === 'register' ? 'Sign in' : 'Create an account' %></a></p>
  </section>
</section>
<footer class="footer"><span>NEON / NOTES</span><span>Your next idea belongs here.</span></footer>
</main></body></html>
