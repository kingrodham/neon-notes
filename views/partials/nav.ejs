<header class="topbar">
  <a class="brand" href="/" aria-label="Neon Notes home"><span class="brand-icon" aria-hidden="true">N</span> NEON<span class="muted">/</span>NOTES</a>
  <nav class="account-nav" aria-label="Account">
    <% if (user) { %>
      <span class="account-name">Hi, <%= user.display_name %></span>
      <form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary" type="submit">Sign out</button></form>
    <% } else { %>
      <a class="text-link" href="/login">Sign in</a>
      <a class="secondary" href="/register">Create account</a>
    <% } %>
  </nav>
</header>
